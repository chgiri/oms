# Copy this file to .env (which is already gitignored) and fill in real
# values before running `docker compose up`. Required vars have no default
# in docker-compose.yml / application.properties and the app/postgres will
# fail to start without them.

# --- Environment profile ---
# One of: dev, test, uat, prod (see src/main/resources/application-{profile}.properties).
# Controls logging verbosity, Swagger UI availability, and whether the throwaway
# JWT/admin/CORS defaults are allowed to be used. Defaults to dev if unset.
# The prod profile requires JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, DEFAULT_ADMIN_PASSWORD
# and CORS_ALLOWED_ORIGINS to all be set explicitly ? it will not start without them.
SPRING_PROFILES_ACTIVE=dev

# --- Postgres (required) ---
DB_NAME=oms
DB_USERNAME=oms_user
# DB_PASSWORD is no longer read by the app container directly (see Vault
# section below) — it's still required here because docker-compose's
# `postgres` service itself needs it, and `vault-init` uses it to seed Vault.
DB_PASSWORD=changeme

# --- Redis ---
# For local also set some temp password. Same note as DB_PASSWORD above:
# still needed here for the `redis` service and for vault-init to seed it,
# just no longer passed to the app container as a plain env var.
REDIS_PASSWORD=devpassword123

# --- JWT (required) ---
# JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (RS256, base64-encoded PEM) are what the app
# actually uses — see application.properties. Both are optional here: if
# unset, vault-init skips seeding them and the app falls back to the
# throwaway dev keypair baked into application-dev.properties.
# Generate a real pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private_key.pem
#   openssl rsa -pubout -in private_key.pem -out public_key.pem
#   base64 -w0 private_key.pem   # -> JWT_PRIVATE_KEY
#   base64 -w0 public_key.pem    # -> JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION_MS=86400000

# --- Default admin account (seeded on first startup if no users exist) ---
DEFAULT_ADMIN_USERNAME=admin
# Same note as DB_PASSWORD/REDIS_PASSWORD — read by vault-init, not by the
# app container directly.
DEFAULT_ADMIN_PASSWORD=Admin@123

# --- HashiCorp Vault (local dev) ---
# Root token for the local dev-mode `vault` container — a throwaway value,
# not a real secret. See vault/README.md for the uat/prod setup, which uses
# Kubernetes auth instead of a token.
VAULT_DEV_ROOT_TOKEN=oms-dev-root-token

# --- Build/release identity (optional) ---
# Ties a built image back to the exact commit/version it came from — see
# Dockerfile and /actuator/info. Left unset, both default to "unknown"/"local"
# so `docker compose up --build` still works with zero setup. For a real
# build, set them from the actual commit before building, e.g.:
#   export GIT_SHA=$(git rev-parse --short HEAD)
#   export APP_VERSION=1.0.0   # or another tag/version scheme you pick
#   docker compose build
GIT_SHA=
APP_VERSION=

# --- Grafana (optional) ---
# Login for http://localhost:3000. Defaults to admin/admin if unset — fine
# for local dev, but set a real password before this port is reachable by
# anyone but you. Prometheus itself (http://localhost:9090) has no auth.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Actuator / metrics (optional) ---
# Health, info, and /actuator/prometheus all live on this port, not
# server.port (8080) — see application.properties. Only change this if 8081
# collides with something else in your environment; docker-compose.yml and
# k8s/ both assume the default.
# MANAGEMENT_SERVER_PORT=8081
